# systemd unit for AlertBot (runs as root from /root/alertbot)
# Install:
#   cp /root/alertbot/alertbot.service /etc/systemd/system/alertbot.service
#   systemctl daemon-reload
#   systemctl enable --now alertbot
#   systemctl status alertbot
#   journalctl -u alertbot -f          # live logs
#
# Note: running as root is simplest but least secure. For a hardened setup, use a
# dedicated user + /opt/alertbot instead (see README).

[Unit]
Description=AlertBot - MonitorFlow to Lark alert bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

User=root
Group=root
WorkingDirectory=/root/alertbot

# .env holds all secrets/config; systemd loads it into the environment.
EnvironmentFile=/root/alertbot/.env

# Playwright needs a writable HOME for its browser cache.
Environment=HOME=/root
# If you installed browsers to a custom path, point Playwright at it instead:
# Environment=PLAYWRIGHT_BROWSERS_PATH=/root/alertbot/.playwright

# Run inside the project virtualenv.
ExecStart=/root/alertbot/.venv/bin/python /root/alertbot/main.py

Restart=always
RestartSec=5
# Give the process time to flush state on stop (main.py handles SIGTERM).
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
