# ============================================================
#  AlertBot configuration — copy to .env and fill in the values
# ============================================================

# --- MonitorFlow dashboard ---
MONITOR_BASE_URL=https://monitor.example.com
MONITOR_USERNAME=your_dashboard_user
MONITOR_PASSWORD=your_dashboard_password

# --- Lark app (open.larksuite.com) ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret
LARK_VERIFICATION_TOKEN=your_verification_token
# International Lark: https://open.larksuite.com  |  China Feishu: https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Chat that new alerts are pushed to. Get it by adding the bot to a group and
# sending "/chatid" (the bot replies with the id). Leave blank to disable pushes.
LARK_ALERT_CHAT_ID=

# --- Report button (where pressing it posts the alert) ---
# DB and Platform alerts go to the OSE & SRE group; LiveSlots alerts to the
# LiveSlot group. Blank = fall back to REPORT_CHAT_ID, then LARK_ALERT_CHAT_ID.
REPORT_CHAT_ID_OSE=oc_7713b00dc15c884caf5ee615ef948ef3
REPORT_CHAT_ID_LIVESLOT=
REPORT_CHAT_ID=
# Button labels — each names the group the report will land in.
REPORT_BUTTON_TEXT=Report to OSE & SRE group
REPORT_BUTTON_TEXT_LIVESLOT=Report to Liveslot SRE - OSE 讨论群

# --- Watcher ---
# critical | warning | info | all
WATCH_SEVERITY=critical
# Alerts-API page size (matches the dashboard view page_size=50).
MONITOR_PAGE_SIZE=50
POLL_INTERVAL_SECONDS=60
# Post an FYI in the alert's thread once it's been firing this long (minutes).
# Comma-separated for multiple reminders, e.g. "15,30,60". Empty = off.
# While an alert keeps firing, re-post it as a NEW card every N minutes:
# "(Firing 15 minutes)", "(Firing 30 minutes)", ... 0 = only the first card.
FIRING_REPEAT_MINUTES=15
ANNOUNCE_BACKLOG_ON_START=false
NOTIFY_ON_RESOLVE=true
# What happens to the alert card when it recovers:
#   collapse = rewrite it in place as one quiet line (no "recalled" notice)
#   delete   = recall it (Lark shows "Alert Bot recalled a message.")
#   card     = leave it, post a resolve card in its thread
# Fires again within this many minutes of resolving = still flapping;
# quiet longer than this resets the counter to a fresh incident.
FLAP_WINDOW_MINUTES=15
RESOLVE_ACTION=card
# Remove an alert from state.json the moment it resolves (after its resolve card
# posts). Keeps state small; makes /check's "resolved" list empty.
CLEAR_RESOLVED=false
# How long resolved alerts stay in /check's "resolved" list (hours). Ignored if
# CLEAR_RESOLVED=true.
STATE_RETENTION_HOURS=24

# --- Screenshot (Playwright) ---
ENABLE_SCREENSHOT=true

# --- Emoji reactions for /check ---
REACTION_PROCESSING=OnIt
REACTION_DONE=DONE
REACTION_ERROR=ERROR
CHECK_COMMAND=/check
# Max entries listed per /check section (safety net for Lark's card size limit)
CHECK_MAX_PER_SECTION=60
# Pages of recent alerts /check scans (firing + resolved) for doc coverage
CHECK_LOOKBACK_PAGES=4
# Deep background scan that catalogues alert names (60 x 200 = 12k alerts, ~2min).
# Runs in the watcher, not in /check, so the command stays fast.
CATALOGUE_PAGES=60
CATALOGUE_REFRESH_MINUTES=60

# --- Self-deploy via DM (git pull + restart) ---
# OFF by default: this runs shell commands (git pull + systemctl restart) on the
# server when an authorized user DMs the bot "/deploy" or "git pull".
DEPLOY_ENABLED=false
# Comma-separated Lark open_ids allowed to deploy (get yours via "/whoami").
# Empty = any DM sender can deploy — set this before enabling in production.
DEPLOY_ADMIN_IDS=
DEPLOY_BRANCH=main
DEPLOY_SERVICE=alertbot
# DEPLOY_GIT_DIR=/root/alertbot   # defaults to the folder the bot runs from

# --- SOP knowledge base (wiki doc -> monitorflow.json) ---
# The bot reads your on-call SOP wiki page every KB_REFRESH_MINUTES, distils it
# with a local LLM into monitorflow.json, and attaches "is this important / what
# do I do" to each alert card. The LLM only re-reads the doc when it changes.
KB_ENABLED=true
# Token from the wiki URL: https://<host>.larksuite.com/wiki/<KB_WIKI_TOKEN>
KB_WIKI_TOKEN=
KB_REFRESH_MINUTES=60
KB_FILE=monitorflow.json
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b
# Optional vision model to also read the doc's screenshots, e.g. qwen2.5vl:3b
# (blank = skip images). Captions are cached per image.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=1800
# Ollama's default context is only 4k, which truncates a long doc and makes the
# model return an EMPTY reply. Keep these above doc+output size.
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=8192
# Per-image vision timeout, and a total budget for captioning the whole doc.
# When the budget is spent the build continues with text only.
OLLAMA_VISION_TIMEOUT_SECONDS=120
KB_CAPTION_BUDGET_SECONDS=600
# Working hours used to choose which SOP guidance to show (Mon=0 … Sun=6)
WORK_START_HOUR=9
WORK_END_HOUR=18
WORK_DAYS=0,1,2,3,4
WORK_TZ_OFFSET_HOURS=8

# --- /log command (read journalctl from chat) ---
# Restricted to DEPLOY_ADMIN_IDS. Output is redacted (tokens/secrets masked).
LOG_COMMAND_ENABLED=true
LOG_DEFAULT_LINES=40
LOG_MAX_LINES=300

# --- Alerts tracker (Lark Base) ---
# Pressing "Report to OSE & SRE group" also files the alert here. One table per
# month ("August 2026"); the Platform/DB views are the same table filtered on
# the Platform field. Only PLATFORM and DB domains are recorded.
TRACKER_ENABLED=true
TRACKER_APP_TOKEN=XwJVbYXH7aiVdMsE8hgly3xJgkf
TRACKER_TABLE_ID=tblg3xYBy31GyTlT
TRACKER_TEMPLATE_TABLE=tblg3xYBy31GyTlT

# --- Misc ---
LOG_LEVEL=INFO
